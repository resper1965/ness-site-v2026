{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "canal",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./admin/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "canal-db",
			"database_id": "bd79ce1a-6fd0-49ef-8d9f-40ea53717e0e"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://canal.ness.workers.dev"
	},
	"alias": {
		"better-auth/adapters/kysely": "./node_modules/better-auth/dist/db/adapter-kysely.mjs"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "canal-vectors"
		}
	],
	"ai": {
		"binding": "AI"
	}
}